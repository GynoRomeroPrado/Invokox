# ==============================================================================
# DOCKERIGNORE - BACKEND
# ==============================================================================
# Archivos a excluir del contexto de Docker build
# ==============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
env/
ENV/
.venv

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Database
*.db
*.sqlite
*.sqlite3
data/

# Logs
logs/
*.log

# Environment
.env
.env.local
.env.*.local

# Git
.git/
.gitignore

# Documentation
*.md
docs/

# Alembic
alembic/versions/*.py
!alembic/versions/.gitkeep

# Models (se descargan en runtime)
models/

# Uploads (se manejan con volúmenes)
uploads/
