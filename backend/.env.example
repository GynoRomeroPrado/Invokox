# Invokox Backend - Environment Variables

# ============================================
# APPLICATION
# ============================================
APP_NAME=Invokox Backend
APP_VERSION=2.0.0
MODE=standalone  # standalone | server
DEBUG=false
ENVIRONMENT=development  # development | staging | production

# ============================================
# DATABASE
# ============================================
# Standalone (SQLite)
DATABASE_URL=sqlite:///./data/invokox.db
SQL_ECHO=false

# Server (SQL Server) - Descomentar y configurar para modo server
# SQL_SERVER_HOST=localhost
# SQL_SERVER_PORT=1433
# SQL_SERVER_DATABASE=invokox_db
# SQL_SERVER_USER=sa
# SQL_SERVER_PASSWORD=YourStrong!Passw0rd
# SQL_SERVER_DRIVER=ODBC Driver 18 for SQL Server

# Database Pool (solo para SQL Server)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ============================================
# REDIS & CELERY
# ============================================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ============================================
# SECURITY
# ============================================
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# OCR/AI CONFIGURATION
# ============================================
OCR_ENGINE=paddleocr  # paddleocr | docling | tesseract
OCR_LANGUAGE=es
USE_GPU=false
MODEL_PATH=./models

# ============================================
# FILE STORAGE
# ============================================
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE=10485760  # 10MB en bytes
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg

# ============================================
# API CONFIGURATION
# ============================================
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FILE=./logs/app.log
LOG_ROTATION=1 day
LOG_RETENTION=30 days

# ============================================
# SYNC CONFIGURATION (para modo dual)
# ============================================
SERVER_API_URL=https://api.company.local
SYNC_INTERVAL_MINUTES=15
SYNC_BATCH_SIZE=100
