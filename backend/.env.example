# Invokox Backend - Environment Variables

# ============================================
# APPLICATION MODE
# ============================================
MODE=standalone  # standalone | server

# ============================================
# DATABASE
# ============================================
# Standalone (SQLite)
DATABASE_URL=sqlite:///./data/facturas.db

# Server (SQL Server)
# DATABASE_URL=mssql+pyodbc://user:password@server:1433/facturas_db?driver=ODBC+Driver+18+for+SQL+Server

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ============================================
# SECURITY
# ============================================
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# OCR/AI CONFIGURATION
# ============================================
OCR_ENGINE=paddleocr  # paddleocr | docling | tesseract
OCR_LANGUAGE=es
USE_GPU=true
MODEL_PATH=./models

# ============================================
# FILE STORAGE
# ============================================
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE=10485760  # 10MB en bytes

# ============================================
# API CONFIGURATION
# ============================================
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR
LOG_FILE=./logs/app.log

# ============================================
# SYNC CONFIGURATION (para modo dual)
# ============================================
SERVER_API_URL=https://api.company.local
SYNC_INTERVAL_MINUTES=15
SYNC_BATCH_SIZE=100
